# Local environment file: copy .env.example to .env and edit. Never commit it.
.env
.env.*
!.env.example

# BEGIN oh-my-opencode-slim worktrees
.slim/worktrees/
.slim/worktrees.json
# END oh-my-opencode-slim worktrees

# opencode local session state (run-continuation JSONs). Machine-local, ever-growing, never commit.
.omo/
.slim/deepwork/

# Go build and test artifacts.
*.test
*.exe
*.out
/vendor/
coverage.out
coverage.html
*.coverprofile
/txharbor
/dist/

# OS and editor local state.
/.DS_Store
Thumbs.db
.idea/
.vscode/
*.tmp
*.swp

# Python bytecode caches.
__pycache__/
*.pyc

# Local evidence workspace (raw run artifacts; local only, not distributed).
/.evidence/

# Local run outputs (the `recovery-admin drill` default archive dir; not
# distributed; override with --out or the *_EVIDENCE_DIR env vars).
/docs/evidence/

# opencode local dependency metadata and caches. The shared workflow lives in
# .opencode/commands/ and stays tracked.
/.opencode/node_modules/
/.opencode/package.json
/.opencode/package-lock.json
/.opencode/bun.lock
/.opencode/.gitignore
