+
+// targetLockRollbackBudget is the independent bounded budget of the rollback
+// cleanup and of the uncertain-rollback disposal. The caller context is never
+// used for this cleanup: an already cancelled caller must not strand the owner
+// transaction.
+const targetLockRollbackBudget = 10 * time.Second
+
+// retireOwnerAfterUncertainRollbackLocked permanently retires the owner handle
+// after an uncertain rollback and boundedly disposes its dedicated connection.
+// It deliberately does not use the Release SQL path and never performs an
+// unbounded close; the caller must hold l.mu.
+func (l *TargetLock) retireOwnerAfterUncertainRollbackLocked() {
+	if l.closed {
+		return
+	}
+	l.closed = true
+	if l.conn == nil {
+		return
+	}
+	disposeCtx, cancelDispose := context.WithTimeout(context.Background(), targetLockRollbackBudget)
+	defer cancelDispose()
+	_ = l.conn.Close(disposeCtx)
+}
