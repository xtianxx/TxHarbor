+// connector or socket callback authority is added.
+func (f *TargetLockCommitAmbiguityFault) ArmRollbackGate() {
+	f.core.mu.Lock()
+	f.core.armed = true
+	f.core.rollbackOnly = true
+	f.core.mu.Unlock()
+}
