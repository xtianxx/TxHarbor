+// borrowedReplacementCommitAmbiguityFrame appends one backend protocol frame
+// for the deterministic malformed-completion controls.
+func borrowedReplacementCommitAmbiguityFrame(dst []byte, messageType byte, body []byte) []byte {
+	dst = append(dst, messageType)
+	dst = binary.BigEndian.AppendUint32(dst, uint32(4+len(body)))
+	return append(dst, body...)
+}
