+//go:build linux && drill
+
+// targetlock_commitambiguity_hook_linux_test.go is the drill-only fixed
+// companion of the owner COMMIT acknowledgement-loss lane. It reserves the
+// unexported production socket-wrap seam with ONE fixed wire gate and exposes
+// ONLY opaque fault controls: arm, automatic withhold of the validated server
+// completion, break and witness queries, plus a deterministic in-memory
+// control transport. It never exposes a raw connection, a caller-supplied
+// socket callback, a connector or SQL authority, and it never changes the DSN,
+// key, owner, canonical identity checks or acquisition machinery. WITHHELD is
+// published only after the ACTUAL PostgreSQL COMMIT completion
+// (CommandComplete('COMMIT') + ReadyForQuery) has been bounded-assembled and
+// validated; EOF, read errors, deadline expiry, partial and unrecognized
+// framing stay NOTESTABLISHED/UNCERTAIN and are never inferred as a rollback
+// or a success.
+package recovery
+
+import (
+	"bytes"
+	"context"
+	"encoding/binary"
+	"errors"
+	"io"
+	"net"
+	"os"
+	"sync"
+	"time"
+)
+
+// Fixed witness strings of the fault control.
+const (
+	TargetLockCommitWitnessNotEstablished = "not-established"
+	TargetLockCommitWitnessDispatched     = "dispatched"
+	TargetLockCommitWitnessWithheld       = "withheld"
+)
+
+// TargetLockCommitAmbiguityFault is the fixed opaque fault control. When it
+// wraps a real owner socket it also implements net.Conn; callers only ever get
+// the armed handle, never the underlying connection.
+type TargetLockCommitAmbiguityFault struct {
+	real net.Conn
+
+	mu           sync.Mutex
+	armed        bool
+	dispatched   bool
+	withheld     bool
+	broken       bool
+	readFailure  bool
+	unrecognized int
+	wrapped      int
+	withholdErr  error
+
+	dispatchedCh chan struct{}
+	withheldCh   chan struct{}
+	brokenCh     chan struct{}
+	withholdOnce sync.Once
+	breakOnce    sync.Once
+
+	// deterministic in-memory transport of the control instance
+	controlMu        sync.Mutex
+	controlServer    bytes.Buffer
+	controlServerErr error
+
+	// deadline/cancellation awareness of the withheld wait
+	deadlineMu      sync.Mutex
+	readDeadline    time.Time
+	deadlineChanged chan struct{}
+}
+
+func newTargetLockCommitAmbiguityFault() *TargetLockCommitAmbiguityFault {
+	return &TargetLockCommitAmbiguityFault{
+		dispatchedCh:    make(chan struct{}),
+		withheldCh:      make(chan struct{}),
+		brokenCh:        make(chan struct{}),
+		deadlineChanged: make(chan struct{}, 1),
+	}
+}
+
+// ArmTargetLockCommitAmbiguityFault reserves the production socket-wrap seam
+// with this fixed fault and returns the opaque handle, the identity-conditional
+// reset and an error for an overlapping reservation. No socket callback is
+// accepted.
+func ArmTargetLockCommitAmbiguityFault() (*TargetLockCommitAmbiguityFault, func(), error) {
+	fault := newTargetLockCommitAmbiguityFault()
+	reset, err := reserveTargetLockSocketWrap(fault.wrap)
+	if err != nil {
+		return nil, nil, err
+	}
+	return fault, reset, nil
+}
+
+// NewTargetLockCommitAmbiguityControl builds the deterministic control
+// instance (never installed into the production seam) whose fixed in-memory
+// transport is driven through ControlWriteClientBytes / ControlFeedServerBytes
+// / ControlFeedServerError / ControlRead.
+func NewTargetLockCommitAmbiguityControl() *TargetLockCommitAmbiguityFault {
+	return newTargetLockCommitAmbiguityFault()
+}
+
+// TargetLockCommitRequestFrame is the exact simple-protocol commit query frame
+// pgx sends for tx.Commit.
+func TargetLockCommitRequestFrame() []byte {
+	sql := "commit"
+	frame := make([]byte, 5+len(sql)+1)
+	frame[0] = 'Q'
+	binary.BigEndian.PutUint32(frame[1:5], uint32(4+len(sql)+1))
+	copy(frame[5:], sql)
+	return frame
+}
+
+// TargetLockCommitCompletionFrames is the REAL PostgreSQL COMMIT completion:
+// CommandComplete('COMMIT') followed by ReadyForQuery('I').
+func TargetLockCommitCompletionFrames() []byte {
+	tag := []byte("COMMIT\x00")
+	frames := make([]byte, 0, 32)
+	frames = append(frames, 'C')
+	frames = binary.BigEndian.AppendUint32(frames, uint32(4+len(tag)))
+	frames = append(frames, tag...)
+	frames = append(frames, 'Z')
+	frames = binary.BigEndian.AppendUint32(frames, 5)
+	frames = append(frames, 'I')
+	return frames
+}
+
+// wrap is the fixed wrapper reserved into the production seam: it records the
+// REAL established socket exactly once and returns the fault itself.
+func (f *TargetLockCommitAmbiguityFault) wrap(real net.Conn) net.Conn {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.wrapped++
+	if real == nil || f.real != nil {
+		return real
+	}
+	f.real = real
+	return f
+}
+
+// ArmGate arms the wire gate: the ACTUAL commit request is then recognized,
+// forwarded (the server really commits) and its validated completion withheld
+// before pgx receives it.
+func (f *TargetLockCommitAmbiguityFault) ArmGate() {
+	f.mu.Lock()
+	f.armed = true
+	f.mu.Unlock()
+}
+
+// Break breaks the owner transport so the ACTUAL Commit call returns an error.
+func (f *TargetLockCommitAmbiguityFault) Break() {
+	f.breakOnce.Do(func() {
+		f.mu.Lock()
+		f.broken = true
+		real := f.real
+		f.mu.Unlock()
+		if real != nil {
+			_ = real.Close()
+		}
+		close(f.brokenCh)
+	})
+}
+
+// Close satisfies net.Conn and breaks the transport.
+func (f *TargetLockCommitAmbiguityFault) Close() error {
+	f.Break()
+	return nil
+}
+
+// Witness returns ONLY the ordering actually established.
+func (f *TargetLockCommitAmbiguityFault) Witness() string {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if f.withheld {
+		return TargetLockCommitWitnessWithheld
+	}
+	if f.dispatched {
+		return TargetLockCommitWitnessDispatched
+	}
+	return TargetLockCommitWitnessNotEstablished
+}
+
+// WrappedCount is the number of real sockets the fixed wrapper has seen.
+func (f *TargetLockCommitAmbiguityFault) WrappedCount() int {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.wrapped
+}
+
+// UnrecognizedFramingCount counts client writes the fixed classifier could not
+// recognize while armed.
+func (f *TargetLockCommitAmbiguityFault) UnrecognizedFramingCount() int {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.unrecognized
+}
+
+// ReadFailed reports an EOF/error/partial/unrecognized completion read.
+func (f *TargetLockCommitAmbiguityFault) ReadFailed() bool {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.readFailure
+}
+
+// CleanupUncertain reports a broken or failed-read transport whose COMMIT
+// completion was never withheld: the actual outcome is UNKNOWN and must never
+// be inferred as a rollback.
+func (f *TargetLockCommitAmbiguityFault) CleanupUncertain() bool {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return (f.broken || f.readFailure) && !f.withheld
+}
+
+// AwaitDispatched waits boundedly for the actual COMMIT dispatch witness.
+func (f *TargetLockCommitAmbiguityFault) AwaitDispatched(ctx context.Context) bool {
+	select {
+	case <-f.dispatchedCh:
+		return true
+	case <-ctx.Done():
+		return false
+	}
+}
+
+// AwaitWithheld waits boundedly for the validated withheld completion witness.
+func (f *TargetLockCommitAmbiguityFault) AwaitWithheld(ctx context.Context) bool {
+	select {
+	case <-f.withheldCh:
+		return true
+	case <-ctx.Done():
+		return false
+	}
+}
+
+// ControlWriteClientBytes drives the fixed classifier with client bytes.
+func (f *TargetLockCommitAmbiguityFault) ControlWriteClientBytes(b []byte) error {
+	_, err := f.Write(b)
+	return err
+}
+
+// ControlFeedServerBytes queues server bytes for the deterministic transport.
+func (f *TargetLockCommitAmbiguityFault) ControlFeedServerBytes(b []byte) {
+	f.controlMu.Lock()
+	f.controlServer.Write(b)
+	f.controlMu.Unlock()
+}
+
+// ControlFeedServerError queues one read failure for the deterministic
+// transport.
+func (f *TargetLockCommitAmbiguityFault) ControlFeedServerError(err error) {
+	f.controlMu.Lock()
+	f.controlServerErr = err
+	f.controlMu.Unlock()
+}
+
+// ControlRead drives the fixed Read path once.
+func (f *TargetLockCommitAmbiguityFault) ControlRead(p []byte) (int, error) {
+	return f.Read(p)
+}
+
+func (f *TargetLockCommitAmbiguityFault) realConn() net.Conn {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.real
+}
+
+func (f *TargetLockCommitAmbiguityFault) Write(p []byte) (int, error) {
+	if real := f.realConn(); real != nil {
+		n, err := real.Write(p)
+		if n > 0 {
+			f.maybeEstablishDispatch(p[:n])
+		}
+		return n, err
+	}
+	f.maybeEstablishDispatch(p)
+	return len(p), nil
+}
+
+func (f *TargetLockCommitAmbiguityFault) maybeEstablishDispatch(p []byte) {
+	f.mu.Lock()
+	if !f.armed || f.dispatched {
+		f.mu.Unlock()
+		return
+	}
+	f.mu.Unlock()
+	commit, recognized := classifyTargetLockCommitFrame(p)
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if !f.armed || f.dispatched {
+		return
+	}
+	if !recognized {
+		f.unrecognized++
+		return
+	}
+	if commit {
+		f.dispatched = true
+		close(f.dispatchedCh)
+	}
+}
+
+func (f *TargetLockCommitAmbiguityFault) Read(p []byte) (int, error) {
+	f.mu.Lock()
+	withhold := f.armed && f.dispatched && !f.withheld && !f.broken
+	f.mu.Unlock()
+	if !withhold {
+		return f.readRaw(p)
+	}
+	f.withholdOnce.Do(func() {
+		err := f.withholdCommitCompletion()
+		f.mu.Lock()
+		f.withholdErr = err
+		if err == nil {
+			f.withheld = true
+		}
+		f.mu.Unlock()
+		if err == nil {
+			close(f.withheldCh)
+		}
+	})
+	f.mu.Lock()
+	withholdErr := f.withholdErr
+	withheld := f.withheld
+	f.mu.Unlock()
+	if withholdErr != nil {
+		return 0, withholdErr
+	}
+	if !withheld {
+		return 0, net.ErrClosed
+	}
+	return 0, f.waitAfterWithhold()
+}
+
+// withholdCommitCompletion bounded-assembles and validates the ACTUAL
+// PostgreSQL COMMIT completion; failure marks the read failed and NEVER
+// publishes WITHHELD.
+func (f *TargetLockCommitAmbiguityFault) withholdCommitCompletion() error {
+	const completionLimit = 1 << 16
+	assemblyDeadline := time.Now().Add(30 * time.Second)
+	assembled := make([]byte, 0, 256)
+	scratch := make([]byte, 512)
+	for len(assembled) <= completionLimit {
+		if real := f.realConn(); real != nil {
+			remaining := time.Until(assemblyDeadline)
+			if remaining <= 0 {
+				f.markReadFailure()
+				return os.ErrDeadlineExceeded
+			}
+			_ = real.SetReadDeadline(time.Now().Add(remaining))
+		}
+		n, err := f.readRaw(scratch)
+		if n > 0 {
+			assembled = append(assembled, scratch[:n]...)
+		}
+		if err != nil {
+			f.markReadFailure()
+			return err
+		}
+		if targetLockCommitCompletionAssembled(assembled) {
+			return nil
+		}
+	}
+	f.markReadFailure()
+	f.markUnrecognized()
+	return errors.New("target-lock COMMIT completion framing was not recognized")
+}
+
+// waitAfterWithhold blocks until the transport is broken or the tracked read
+// deadline expires; deadline changes and Close are honored and a timeout fails
+// closed without upgrading the witness.
+func (f *TargetLockCommitAmbiguityFault) waitAfterWithhold() error {
+	for {
+		f.deadlineMu.Lock()
+		deadline := f.readDeadline
+		f.deadlineMu.Unlock()
+		var timer *time.Timer
+		var timerCh <-chan time.Time
+		if !deadline.IsZero() {
+			remaining := time.Until(deadline)
+			if remaining <= 0 {
+				return os.ErrDeadlineExceeded
+			}
+			timer = time.NewTimer(remaining)
+			timerCh = timer.C
+		}
+		select {
+		case <-f.brokenCh:
+			if timer != nil {
+				timer.Stop()
+			}
+			return net.ErrClosed
+		case <-timerCh:
+			f.deadlineMu.Lock()
+			current := f.readDeadline
+			f.deadlineMu.Unlock()
+			if !current.IsZero() && !time.Now().Before(current) {
+				return os.ErrDeadlineExceeded
+			}
+		case <-f.deadlineChanged:
+			if timer != nil {
+				timer.Stop()
+			}
+		}
+	}
+}
+
+func (f *TargetLockCommitAmbiguityFault) readRaw(p []byte) (int, error) {
+	if real := f.realConn(); real != nil {
+		return real.Read(p)
+	}
+	f.controlMu.Lock()
+	defer f.controlMu.Unlock()
+	if f.controlServerErr != nil {
+		err := f.controlServerErr
+		f.controlServerErr = nil
+		return 0, err
+	}
+	if f.controlServer.Len() == 0 {
+		return 0, io.EOF
+	}
+	return f.controlServer.Read(p)
+}
+
+func (f *TargetLockCommitAmbiguityFault) markReadFailure() {
+	f.mu.Lock()
+	f.readFailure = true
+	f.mu.Unlock()
+}
+
+func (f *TargetLockCommitAmbiguityFault) markUnrecognized() {
+	f.mu.Lock()
+	f.unrecognized++
+	f.mu.Unlock()
+}
+
+func (f *TargetLockCommitAmbiguityFault) noteDeadline(t time.Time) {
+	f.deadlineMu.Lock()
+	f.readDeadline = t
+	f.deadlineMu.Unlock()
+	select {
+	case f.deadlineChanged <- struct{}{}:
+	default:
+	}
+}
+
+func (f *TargetLockCommitAmbiguityFault) SetReadDeadline(t time.Time) error {
+	f.noteDeadline(t)
+	if real := f.realConn(); real != nil {
+		return real.SetReadDeadline(t)
+	}
+	return nil
+}
+
+func (f *TargetLockCommitAmbiguityFault) SetDeadline(t time.Time) error {
+	f.noteDeadline(t)
+	if real := f.realConn(); real != nil {
+		return real.SetDeadline(t)
+	}
+	return nil
+}
+
+func (f *TargetLockCommitAmbiguityFault) SetWriteDeadline(t time.Time) error {
+	if real := f.realConn(); real != nil {
+		return real.SetWriteDeadline(t)
+	}
+	return nil
+}
+
+// targetLockCommitAmbiguityAddr is the nil-safe control-mode address.
+type targetLockCommitAmbiguityAddr string
+
+func (a targetLockCommitAmbiguityAddr) Network() string { return "fault-control" }
+func (a targetLockCommitAmbiguityAddr) String() string  { return string(a) }
+
+func (f *TargetLockCommitAmbiguityFault) LocalAddr() net.Addr {
+	if real := f.realConn(); real != nil {
+		return real.LocalAddr()
+	}
+	return targetLockCommitAmbiguityAddr("fault-control-local")
+}
+
+func (f *TargetLockCommitAmbiguityFault) RemoteAddr() net.Addr {
+	if real := f.realConn(); real != nil {
+		return real.RemoteAddr()
+	}
+	return targetLockCommitAmbiguityAddr("fault-control-remote")
+}
+
+// classifyTargetLockCommitFrame recognizes the actual simple-protocol COMMIT
+// query frame and never claims an establishment for unrecognized, partial or
+// non-commit framing.
+func classifyTargetLockCommitFrame(p []byte) (commit, recognized bool) {
+	for len(p) > 0 {
+		if len(p) < 5 {
+			return false, false
+		}
+		messageType := p[0]
+		length := int(binary.BigEndian.Uint32(p[1:5]))
+		if length < 4 || 1+length > len(p) {
+			return false, false
+		}
+		body := p[5 : 1+length]
+		if messageType == 'Q' {
+			sql := string(bytes.TrimRight(body, "\x00"))
+			sql = string(trimASCIIWhitespace(sql))
+			if equalFoldASCII(sql, "commit") {
+				return true, true
+			}
+		}
+		p = p[1+length:]
+	}
+	return false, true
+}
+
+// targetLockCommitCompletionAssembled validates the REAL COMMIT completion:
+// CommandComplete('COMMIT') followed by ReadyForQuery. Any other command
+// completion, unknown frame or partial framing is not a completion.
+func targetLockCommitCompletionAssembled(buf []byte) bool {
+	commitComplete := false
+	for len(buf) >= 5 {
+		messageType := buf[0]
+		length := int(binary.BigEndian.Uint32(buf[1:5]))
+		if length < 4 || 1+length > len(buf) {
+			return false
+		}
+		body := buf[5 : 1+length]
+		switch messageType {
+		case 'C':
+			if string(bytes.TrimRight(body, "\x00")) != "COMMIT" {
+				return false
+			}
+			commitComplete = true
+		case 'Z':
+			return commitComplete
+		case 'N', 'S', 'A':
+			// asynchronous/notice traffic is skipped
+		default:
+			return false
+		}
+		buf = buf[1+length:]
+	}
+	return false
+}
+
+func trimASCIIWhitespace(s string) []byte {
+	start := 0
+	for start < len(s) && (s[start] == ' ' || s[start] == '\t' || s[start] == '\n' || s[start] == '\r') {
+		start++
+	}
+	end := len(s)
+	for end > start && (s[end-1] == ' ' || s[end-1] == '\t' || s[end-1] == '\n' || s[end-1] == '\r') {
+		end--
+	}
+	return []byte(s[start:end])
+}
+
+func equalFoldASCII(a, b string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := 0; i < len(a); i++ {
+		ca, cb := a[i], b[i]
+		if 'A' <= ca && ca <= 'Z' {
+			ca += 'a' - 'A'
+		}
+		if 'A' <= cb && cb <= 'Z' {
+			cb += 'a' - 'A'
+		}
+		if ca != cb {
+			return false
+		}
+	}
+	return true
+}
