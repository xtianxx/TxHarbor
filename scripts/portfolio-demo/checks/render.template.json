{
  "name": "__NAME__",
  "services": {
    "postgres": {
      "image": "postgres:18.6-trixie",
      "ports": [
        {"mode": "ingress", "host_ip": "127.0.0.1", "target": 5432, "published": "55436", "protocol": "tcp"}
      ]
    },
    "anvil": {
      "image": "ghcr.io/foundry-rs/foundry:v1.8.1",
      "entrypoint": ["anvil"],
      "command": ["--host", "0.0.0.0", "--port", "8545", "--chain-id", "31337"],
      "ports": [
        {"mode": "ingress", "host_ip": "127.0.0.1", "target": 8545, "published": "58547", "protocol": "tcp"}
      ]
    }
  },
  "volumes": {
    "pgdata": {"name": "__NAME___pgdata"}
  }
}
