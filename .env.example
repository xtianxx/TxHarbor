# TxHarbor 001-project-foundation configuration (env-only, see data-model §1).
# Copy to .env, adjust values, then: set -a; source .env; set +a
# Never commit real credentials: this file only carries placeholders.

# Required: Postgres connection string (any DSN pgx accepts).
TXHARBOR_PG_DSN=postgres://txharbor:txharbor@127.0.0.1:5432/txharbor?sslmode=disable

# Required: external EVM JSON-RPC endpoint.
TXHARBOR_RPC_URL=http://127.0.0.1:8545

# Required: expected chain id; mismatches refuse readiness.
TXHARBOR_CHAIN_ID=31337

# Required: first height to index; 0 (genesis) is legal, no default.
TXHARBOR_START_HEIGHT=0

# Optional: per-call JSON-RPC timeout for the indexer (default 5s).
TXHARBOR_INDEX_RPC_TIMEOUT=5s

# Optional: poll interval while waiting for the next block (default 1s).
TXHARBOR_INDEX_POLL_INTERVAL=1s

# Optional: retry backoff initial value (default 200ms).
TXHARBOR_INDEX_RETRY_INITIAL=200ms

# Optional: retry backoff ceiling (default 30s).
TXHARBOR_INDEX_RETRY_MAX=30s

# Required: first height for the ERC-20 Transfer log scan; 0 (genesis) is legal,
# no default. Independent from TXHARBOR_START_HEIGHT (003 FR-02).
TXHARBOR_LOG_START_HEIGHT=0

# Required: comma-separated ERC-20 contract allowlist for Transfer log indexing.
# A blank or empty list refuses startup; it never degrades into a full-chain
# query (003 FR-04). The order/duplicates/case do not matter.
TXHARBOR_LOG_CONTRACTS=0x1111111111111111111111111111111111111111

# Optional: max blocks per eth_getLogs interval (default 500); re-checked
# against the provider annex before production (003 FR-12/R6).
TXHARBOR_LOG_BATCH_BLOCKS=500

# Required: first height for the 004 deposit scan; 0 (genesis) is legal, no
# default. Independent from TXHARBOR_START_HEIGHT and TXHARBOR_LOG_START_HEIGHT
# (004 FR-04). Also the default effective height for the two lists below.
TXHARBOR_DEPOSIT_START_HEIGHT=0

# Required: comma-separated ERC-20 contract allowlist for deposit detection,
# each item `address[:effective]`; a missing `:effective` defaults to
# TXHARBOR_DEPOSIT_START_HEIGHT. A blank or empty list refuses startup; it
# never degrades into all-contract detection (004 FR-04). Order/duplicates/
# case do not matter, and the same address at different heights stays distinct.
TXHARBOR_DEPOSIT_CONTRACTS=0x1111111111111111111111111111111111111111:0

# Required: comma-separated addresses whose incoming Transfers are monitored,
# same `address[:effective]` syntax and blank-list rule as the contracts above;
# a blank list never degrades into all-address monitoring (004 FR-04).
TXHARBOR_DEPOSIT_WATCH_ADDRESSES=0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:0

# Optional: max blocks per deposit scan interval (default 500). Batch and
# timeout knobs are tuning only and never enter the versioned deposit config
# identity (004 FR-06/R3/R7).
TXHARBOR_DEPOSIT_BATCH_BLOCKS=500

# Required: blocks of confirmation depth for deposit confirmation; must be a
# positive decimal integer in [1, 9223372036854775807] (BIGINT system range,
# no business cap), no default. Missing/non-integer/<1/out-of-range values
# refuse startup (005 FR-03/Q1).
TXHARBOR_CONFIRMATION_DEPTH=10

# Optional: probe HTTP listen address (default 127.0.0.1:8080).
TXHARBOR_HTTP_ADDR=127.0.0.1:8080

# Optional: total startup budget (default 30s).
TXHARBOR_STARTUP_TIMEOUT=30s

# Optional: probe interval (default 2s); interval+timeout must be < 10s.
TXHARBOR_PROBE_INTERVAL=2s

# Optional: single probe timeout (default 5s).
TXHARBOR_PROBE_TIMEOUT=5s

# Optional: graceful shutdown budget (default 15s).
TXHARBOR_SHUTDOWN_TIMEOUT=15s

# Optional: max wait for the migration lock (default 30s).
TXHARBOR_MIGRATE_LOCK_TIMEOUT=30s

# Optional: comma-separated issuer caller_ids; empty = deny-all.
# TXHARBOR_AUTHZ_ISSUER_CALLERS=
