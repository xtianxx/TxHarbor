# TxHarbor 001-project-foundation configuration (env-only, see data-model §1).
# Copy to .env, adjust values, then: set -a; source .env; set +a
# Never commit real credentials: this file only carries placeholders.

# Required: Postgres connection string (any DSN pgx accepts).
TXHARBOR_PG_DSN=postgres://txharbor:txharbor@127.0.0.1:5432/txharbor?sslmode=disable

# Required: external EVM JSON-RPC endpoint.
TXHARBOR_RPC_URL=http://127.0.0.1:8545

# Required: expected chain id; mismatches refuse readiness.
TXHARBOR_CHAIN_ID=31337

# Optional: probe HTTP listen address (default 127.0.0.1:8080).
TXHARBOR_HTTP_ADDR=127.0.0.1:8080

# Optional: total startup budget (default 30s).
TXHARBOR_STARTUP_TIMEOUT=30s

# Optional: probe interval (default 2s); interval+timeout must be < 10s.
TXHARBOR_PROBE_INTERVAL=2s

# Optional: single probe timeout (default 5s).
TXHARBOR_PROBE_TIMEOUT=5s

# Optional: graceful shutdown budget (default 15s).
TXHARBOR_SHUTDOWN_TIMEOUT=15s

# Optional: max wait for the migration lock (default 30s).
TXHARBOR_MIGRATE_LOCK_TIMEOUT=30s
