# TxHarbor development configuration (env-only; full reference: docs/configuration.md).
# `serve` starts from this file as-is (001–006 required keys are active below);
# signer / worker / events / admin-CLI keys are registered and commented out —
# uncomment the ones your process needs.
# Copy to .env, adjust values, then: set -a; source .env; set +a
# Never commit real credentials: this file only carries placeholders.

# Required: Postgres connection string (any DSN pgx accepts).
TXHARBOR_PG_DSN=postgres://txharbor:txharbor@127.0.0.1:5432/txharbor?sslmode=disable

# Required: external EVM JSON-RPC endpoint.
TXHARBOR_RPC_URL=http://127.0.0.1:8545

# Required: expected chain id; mismatches refuse readiness.
TXHARBOR_CHAIN_ID=31337

# Required: first height to index; 0 (genesis) is legal, no default.
TXHARBOR_START_HEIGHT=0

# Optional: per-call JSON-RPC timeout for the indexer (default 5s).
TXHARBOR_INDEX_RPC_TIMEOUT=5s

# Optional: poll interval while waiting for the next block (default 1s).
TXHARBOR_INDEX_POLL_INTERVAL=1s

# Optional: retry backoff initial value (default 200ms).
TXHARBOR_INDEX_RETRY_INITIAL=200ms

# Optional: retry backoff ceiling (default 30s).
TXHARBOR_INDEX_RETRY_MAX=30s

# Required: first height for the ERC-20 Transfer log scan; 0 (genesis) is legal,
# no default. Independent from TXHARBOR_START_HEIGHT (003 FR-02).
TXHARBOR_LOG_START_HEIGHT=0

# Required: comma-separated ERC-20 contract allowlist for Transfer log indexing.
# A blank or empty list refuses startup; it never degrades into a full-chain
# query (003 FR-04). The order/duplicates/case do not matter.
TXHARBOR_LOG_CONTRACTS=0x1111111111111111111111111111111111111111

# Optional: max blocks per eth_getLogs interval (default 500); re-checked
# against the provider annex before production (003 FR-12/R6).
TXHARBOR_LOG_BATCH_BLOCKS=500

# Required: first height for the 004 deposit scan; 0 (genesis) is legal, no
# default. Independent from TXHARBOR_START_HEIGHT and TXHARBOR_LOG_START_HEIGHT
# (004 FR-04). Also the default effective height for the two lists below.
TXHARBOR_DEPOSIT_START_HEIGHT=0

# Required: comma-separated ERC-20 contract allowlist for deposit detection,
# each item `address[:effective]`; a missing `:effective` defaults to
# TXHARBOR_DEPOSIT_START_HEIGHT. A blank or empty list refuses startup; it
# never degrades into all-contract detection (004 FR-04). Order/duplicates/
# case do not matter, and the same address at different heights stays distinct.
TXHARBOR_DEPOSIT_CONTRACTS=0x1111111111111111111111111111111111111111:0

# Required: comma-separated addresses whose incoming Transfers are monitored,
# same `address[:effective]` syntax and blank-list rule as the contracts above;
# a blank list never degrades into all-address monitoring (004 FR-04).
TXHARBOR_DEPOSIT_WATCH_ADDRESSES=0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa:0

# Optional: max blocks per deposit scan interval (default 500). Batch and
# timeout knobs are tuning only and never enter the versioned deposit config
# identity (004 FR-06/R3/R7).
TXHARBOR_DEPOSIT_BATCH_BLOCKS=500

# Required: blocks of confirmation depth for deposit confirmation; must be a
# positive decimal integer in [1, 9223372036854775807] (BIGINT system range,
# no business cap), no default. Missing/non-integer/<1/out-of-range values
# refuse startup (005 FR-03/Q1).
TXHARBOR_CONFIRMATION_DEPTH=10

# Required (006): maximum reorg depth tracked for recovery. Positive decimal
# integer in [1, 9223372036854775807], no default; `serve` refuses to start when
# it is missing or invalid (loader-level commands such as `migrate` do not read
# it). The value below is a development example, not a production threshold.
TXHARBOR_REORG_MAX_DEPTH=64

# Optional (006): replay batch size while re-indexing a reorged range (default 500).
# TXHARBOR_REORG_REPLAY_BATCH=500

# Optional: probe HTTP listen address (default 127.0.0.1:8080).
TXHARBOR_HTTP_ADDR=127.0.0.1:8080

# Optional: total startup budget (default 30s).
TXHARBOR_STARTUP_TIMEOUT=30s

# Optional: probe interval (default 2s); interval+timeout must be < 10s.
TXHARBOR_PROBE_INTERVAL=2s

# Optional: single probe timeout (default 5s).
TXHARBOR_PROBE_TIMEOUT=5s

# Optional: graceful shutdown budget (default 15s).
TXHARBOR_SHUTDOWN_TIMEOUT=15s

# Optional: max wait for the migration lock (default 30s).
TXHARBOR_MIGRATE_LOCK_TIMEOUT=30s

# Optional: comma-separated issuer caller_ids; empty = deny-all.
# TXHARBOR_AUTHZ_ISSUER_CALLERS=

# Optional (008): bearer token for the nonce read-only endpoints; when unset the
# read API refuses every request (fail-closed).
# TXHARBOR_NONCE_READ_TOKEN=

# --- 009 signer service (read by signer-serve) ---
#
# MODE: development | production (default production). production refuses to
# start without a non-local key provider (v1 has none: no KMS/HSM).
# TXHARBOR_SIGNER_MODE=development
# Required in development mode: path to the local key file (never commit keys).
# TXHARBOR_SIGNER_KEY_FILE=./dev-signer-key.json
# Required in every mode: signing policy ceilings; a missing key refuses
# signer-serve startup. Note: a *malformed* value (e.g. a bad chain id) makes
# every command that loads this environment refuse, so keep these valid.
# TXHARBOR_SIGNER_CHAINS=31337
# TXHARBOR_SIGNER_SENDERS=0x0000000000000000000000000000000000000001
# TXHARBOR_SIGNER_ASSETS=0x1111111111111111111111111111111111111111
# TXHARBOR_SIGNER_RECIPIENTS=0x0000000000000000000000000000000000000002
# TXHARBOR_SIGNER_MAX_AMOUNT=1000000000000000000
# TXHARBOR_SIGNER_MAX_GAS_LIMIT=200000
# TXHARBOR_SIGNER_MAX_FEE_PER_GAS=1000000000
# TXHARBOR_SIGNER_MAX_PRIORITY_FEE_PER_GAS=1000000000
# TXHARBOR_SIGNER_MAX_GAS_PRICE=1000000000
# Optional: TXHARBOR_SIGNER_HTTP_ADDR (default 127.0.0.1:8091),
# TXHARBOR_SIGNER_KEY_TIMEOUT (default 5s).

# --- 011 withdrawal worker (read by withdrawal-worker) ---
#
# Required: signer endpoint and the credential issued by `signer-auth` (the
# credential is persisted in PostgreSQL — issue it first, then paste it here).
# TXHARBOR_TX_SIGNER_URL=http://127.0.0.1:8091
# TXHARBOR_TX_SIGNER_CREDENTIAL=
# Optional pacing (defaults exist): TXHARBOR_TX_SEND_TIMEOUT (15s),
# TXHARBOR_WORKER_TTL_SECONDS (30), TXHARBOR_WORKER_HEARTBEAT_SECONDS (10),
# TXHARBOR_WORKER_STALL_SECONDS (300), TXHARBOR_WORKER_BACKOFF_BASE_MS,
# TXHARBOR_WORKER_BACKOFF_MAX_MS, TXHARBOR_WORKER_SCAN_INTERVAL_MS,
# TXHARBOR_WORKER_LABEL.

# --- 013 reliable-event infrastructure (register only; uncomment to use) ---
#
# Env-only keys consumed by the 013 event pipeline. EVERY value below is
# commented out: sourcing this file as-is must not change the existing
# (PG + Anvil) setup — an active TXHARBOR_REDIS_ADDR alone would wire the
# rate limiter and refuse new withdrawals whenever Redis is absent, even
# while TXHARBOR_EVENTS_ENABLED is false. Uncomment the switch and the keys
# you need; with the switch on, every key marked "required when enabled"
# must be present or startup is refused fail-closed. Threshold values
# (rate/burst pairs, capacity limits) have no defaults: they are measured
# inputs, never invented production thresholds. No credentials or secrets
# belong in this section.

# Optional: master switch for the 013 event pipeline (default false).
# TXHARBOR_EVENTS_ENABLED=false

# Required when enabled: Redis carrier address as host:port (no default).
# TXHARBOR_REDIS_ADDR=127.0.0.1:6379

# Optional: Redis dial/read/write timeout (default 1s). Also the default for
# TXHARBOR_RATELIMIT_BUDGET below.
# TXHARBOR_REDIS_TIMEOUT=1s

# Optional: Redis cache TTL (default 30s).
# TXHARBOR_REDIS_CACHE_TTL=30s

# Optional: Redis cache key namespace epoch (default 1); rotating it makes
# stale values from a cleared/rebuilt cache unreachable.
# TXHARBOR_REDIS_CACHE_EPOCH=1

# Required when enabled: comma-separated Kafka bootstrap brokers, host:port
# each (no default).
# TXHARBOR_KAFKA_BROKERS=127.0.0.1:9092

# Optional: Kafka topic (default txharbor.events.v1).
# TXHARBOR_KAFKA_TOPIC=txharbor.events.v1

# Optional: Kafka consumer group prefix (default txharbor).
# TXHARBOR_KAFKA_CONSUMER_GROUP_PREFIX=txharbor

# Required when enabled: per-interface-class token bucket, `rate/burst`. These
# are measured inputs with no default; 500/100 is the 013 benchmark's measured
# example pair, not a proposed production threshold. A missing pair refuses
# startup while the feature is on.
# TXHARBOR_RATELIMIT_NEW_WITHDRAWAL=500/100
# TXHARBOR_RATELIMIT_WRITE=500/100
# TXHARBOR_RATELIMIT_QUERY=500/100
# TXHARBOR_RATELIMIT_OPERATOR=500/100
# TXHARBOR_RATELIMIT_RPC=500/100

# Optional: one limiter decision (Allow) budget, including pool wait, dial and
# command; the default inherits TXHARBOR_REDIS_TIMEOUT (zero migration) and an
# explicit value must be <= it. The 200ms below is an explicit verification
# value from the 013 budget studies, not a production SLO
# (docs/evidence/013/redis-latency-budget-design.md §5).
# TXHARBOR_RATELIMIT_BUDGET=200ms

# Optional: outbox publisher cadence and claim settings (technical initial
# defaults: batch 100, poll 1s, lease TTL 30s, backoff 1s..60s; to be
# calibrated after measurement).
# TXHARBOR_EVENTS_PUBLISHER_BATCH=100
# TXHARBOR_EVENTS_PUBLISHER_POLL_INTERVAL=1s
# TXHARBOR_EVENTS_PUBLISHER_LEASE_TTL=30s
# TXHARBOR_EVENTS_PUBLISHER_BACKOFF_BASE=1s
# TXHARBOR_EVENTS_PUBLISHER_BACKOFF_MAX=60s

# Optional: consumer fetch and bounded retry settings (technical initial
# defaults: batch 100, poll 1s, backoff 500ms..30s, retry limit 8, gap wait
# 10s; to be calibrated after measurement).
# TXHARBOR_EVENTS_CONSUMER_BATCH=100
# TXHARBOR_EVENTS_CONSUMER_POLL_INTERVAL=1s
# TXHARBOR_EVENTS_CONSUMER_BACKOFF_BASE=500ms
# TXHARBOR_EVENTS_CONSUMER_BACKOFF_MAX=30s
# TXHARBOR_EVENTS_CONSUMER_RETRY_LIMIT=8
# TXHARBOR_EVENTS_CONSUMER_GAP_WAIT=10s

# Required when enabled: outbox capacity guard; the limits have no default and
# must satisfy 0 < reserve < soft_limit < hard_limit or startup is refused.
# The numbers below are the 013 benchmark's measured example inputs, not
# proposed production thresholds.
# TXHARBOR_EVENTS_CAPACITY_SOFT_LIMIT=100000
# TXHARBOR_EVENTS_CAPACITY_HARD_LIMIT=200000
# TXHARBOR_EVENTS_CAPACITY_RESERVE=1000

# Required when enabled: positive durations (no default; example values below
# are deployment inputs to set from measurement or an explicit ruling). The
# drain target window also feeds the alert sustained window unless overridden.
# TXHARBOR_EVENTS_CAPACITY_RETENTION=24h
# TXHARBOR_EVENTS_CAPACITY_MAX_SHUTDOWN_WINDOW=1h
# TXHARBOR_EVENTS_CAPACITY_DRAIN_TARGET_WINDOW=5m

# Optional: alert emission switch while the feature is enabled (default true;
# observability only, it never gates a decision).
# TXHARBOR_EVENTS_ALERT_ENABLED=true

# Optional: sustained-soft alert window override; absent = derive from
# TXHARBOR_EVENTS_CAPACITY_DRAIN_TARGET_WINDOW.
# TXHARBOR_EVENTS_ALERT_SOFT_SUSTAINED_WINDOW=30m

# --- 014/015 admin CLIs (reconcile-admin / recovery-admin) ---
#
# Setting TXHARBOR_RECOVERY_CONTROL_DSN also enables the 015 recovery gate for
# running processes — leave it unset for the default non-recovery mode.
# TXHARBOR_RECOVERY_CONTROL_DSN=
# TXHARBOR_RECOVERY_PRINCIPAL=
# TXHARBOR_RECOVERY_ARTIFACT_DIR=
# 015 key sets per command: docs/configuration.md §7. The 014 budget keys
# (TXHARBOR_RECON_*) are action-scoped and defined in internal/config/config.go;
# they are not part of the development quick start.
